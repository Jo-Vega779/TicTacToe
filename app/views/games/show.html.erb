<h1>Tic Tac Toe</h1>

<% if @game.status == "ongoing" %>
  <p>Now playing: <strong><%= @game.current_turn_player_name %></strong></p>
<% end %>

<table class="board-table">
  <% @game.board.state.each_with_index do |row, i| %>
    <tr>
      <% row.each_with_index do |cell, j| %>
        <td class="board-cell">
          <div class="cell-inner">
            <% if cell %>
              <span class="token"><%= cell %></span>
            <% else %>
              <% if @game.status == "ongoing" %>
                <%= button_to " ", move_game_path(@game), params: { x: i, y: j }, class: "cell-button" %>
              <% end %>
            <% end %>
          </div>
        </td>
      <% end %>
    </tr>
  <% end %>
</table>

<p>Status: <%= @game.status %></p>

<%= link_to "New Game", new_game_path, method: :get %>
<%= link_to "New Game vs AI", new_vs_ai_games_path %>
<%= link_to "Game History", games_path %>

<!-- Indicadores de jugador usando las clases del CSS moderno -->
<div class="players">
  <div class="player x <%= 'active' if @game.current_turn_symbol == 'X' %>">
    <div class="token">X</div>
    <div class="label">Player X</div>
  </div>

  <div class="player o <%= 'active' if @game.current_turn_symbol == 'O' %>">
    <div class="token">O</div>
    <div class="label">Player O</div>
  </div>
</div>