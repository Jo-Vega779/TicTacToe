<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Tic Tac Toe" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Favicon e íconos para PWA %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Estilos principales (incluye Bootstrap si lo instalaste) %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>

    <%# Importa los scripts definidos en config/importmap.rb %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-bg">
    <div class="app-panel">
      <header class="app-header">
        <h1>Tic Tac Toe</h1>
      </header>

      <main class="app-main">
        <%= yield %>
      </main>

      <footer class="app-footer">
        <%# Footer ligero si se necesita %>
      </footer>
    </div>
  </body>
</html>
